CREATE TABLE dbo.LatestNews
(
    Id INT IDENTITY(1,1) PRIMARY KEY,
    Title NVARCHAR(200) NOT NULL,
    ShortDesc NVARCHAR(500) NOT NULL,
    FullNews NVARCHAR(MAX) NOT NULL,
    CreatedDate DATETIME NOT NULL DEFAULT GETDATE()
);
